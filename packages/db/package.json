{
  "name": "@repo/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/client.js",
  "module": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:generate:postgres": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:push:postgres": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:push:skip-generate": "prisma db push --skip-generate",
    "lint": "eslint . --max-warnings 0",
    "prebuild": "pnpm db:generate",
    "predev": "pnpm db:generate",
    "postinstall": "pnpm db:generate",
    "studio": "prisma studio",
    "seed": "node -e \"import('./dist/seed.js').then(async ({ seed }) => { await seed(); })\"",
    "dev": "tsc --watch",
    "build": "tsc"
  },
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js",
      "default": "./dist/data.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "import": "./dist/seed.js",
      "default": "./dist/seed.js"
    }
  },
  "dependencies": {
    "@repo/env": "workspace:*",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/ui": "workspace:*",
    "@types/node": "^22.13.1",
    "vitest": "^3.0.4"
  }
}
