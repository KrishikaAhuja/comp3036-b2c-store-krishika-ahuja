// This is the Prisma schema file.
// It defines the database tables and fields for the blog app.

generator client {
  provider = "prisma-client-js" // creates the Prisma client used in the code
}

datasource db {
  provider = "sqlite" // uses SQLite as the database
  url      = env("DATABASE_URL") // gets the database URL from the .env file
}

// User roles control whether someone can access the customer site or admin app.
enum UserRole {
  CUSTOMER
  ADMIN
}

// User table stores customer and admin accounts.
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

// Post table stores each blog post.
model Post {
  id            Int      @id @default(autoincrement()) // unique post id, automatically increases
  urlId         String   @unique // unique URL name for the post
  title         String // title of the blog post
  content       String // full blog content
  description   String // short summary of the post
  imageUrl      String // image URL for the post
  category      String // post category
  tags          String // tags stored as comma-separated text
  priceAud      Int      @default(0) // product price in AUD
  stockQuantity Int      @default(0) // available product stock
  date          DateTime @default(now()) // post date, automatically set to current date
  views         Int      @default(0) // number of views, starts at 0
  active        Boolean  @default(true) // controls if the post is visible or hidden
  Likes         Like[] // one post can have many likes
  orderItems    OrderItem[]
}

// Like table stores likes for posts.
model Like {
  postId Int // id of the post being liked
  userIP String // identifies the user who liked the post

  // connects this like to a post.
  // If the post is deleted, its likes are also deleted.
  Post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  // makes postId + userIP the combined primary key.
  // This prevents the same user from liking the same post more than once.
  @@id([postId, userIP])
}

// Order table stores completed customer purchases.
model Order {
  id               Int         @id @default(autoincrement())
  userId           Int
  status           String      @default("PAID")
  paymentProvider  String      @default("mock")
  paymentReference String?
  totalAud         Int
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            OrderItem[]

  @@index([userId])
}

// OrderItem stores each purchased book snapshot for an order.
model OrderItem {
  id             Int    @id @default(autoincrement())
  orderId        Int
  postId         Int?
  title          String
  urlId          String
  imageUrl       String
  unitPriceAud   Int
  quantity       Int
  lineTotalAud   Int
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  post           Post?  @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([postId])
}
